{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "⚡ B1 一键编译烧录（ST-Link，会复位）",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/dev.ps1",
                "flash",
                "-ConfirmIdle",
                "YES"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "runOptions": {
                "instanceLimit": 1
            },
            "problemMatcher": [],
            "detail": "合并烧录Boot＋App，入口0x08000000、App位于0x08020000；空白板和日常下载使用同一入口。烧录任务会暂停、复位MCU，请先停止测试并断开PC。B1使用真实驱动，复位会关闭RK/DDR。"
        },
        {
            "label": "🔨 B1 只编译（不下载）",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/dev.ps1",
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "runOptions": {
                "instanceLimit": 1
            },
            "problemMatcher": [],
            "detail": "合并烧录Boot＋App，入口0x08000000、App位于0x08020000；空白板和日常下载使用同一入口。烧录任务会暂停、复位MCU，请先停止测试并断开PC。B1使用真实驱动，复位会关闭RK/DDR。"
        }
    ]
}
