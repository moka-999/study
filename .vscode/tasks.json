{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "⚡ V2 一键编译烧录（ST-Link，会复位）",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/dev.ps1",
                "flash",
                "-ConfirmIdle",
                "YES",
                "-PowerSimulation",
                "-MatsFailTest"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "runOptions": {
                "instanceLimit": 1
            },
            "problemMatcher": [],
            "detail": "合并烧录Boot＋App，入口0x08000000、App位于0x08020000；空白板和日常下载使用同一入口。烧录任务会暂停、复位MCU，请先停止测试并断开PC。V2保留电源模拟及MATS第一颗假FAIL。"
        },
        {
            "label": "🔨 V2 只编译（不下载）",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/dev.ps1",
                "build",
                "-PowerSimulation",
                "-MatsFailTest"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "runOptions": {
                "instanceLimit": 1
            },
            "problemMatcher": [],
            "detail": "合并烧录Boot＋App，入口0x08000000、App位于0x08020000；空白板和日常下载使用同一入口。烧录任务会暂停、复位MCU，请先停止测试并断开PC。V2保留电源模拟及MATS第一颗假FAIL。"
        }
    ]
}
